# ---- Brand (everything user-facing is configurable)
BRAND_NAME=ElimuWrite
BRAND_TAGLINE="Write better. Understand your sources. Submit with confidence."
BRAND_PRIMARY=#14284b
BRAND_ACCENT=#1f8a84
PUBLIC_URL=http://localhost:3000

# ---- Server
PORT=3000
# The app connects as a role WITHOUT table ownership so row-level security applies.
DATABASE_URL=postgres://elimu_app:elimu_app@localhost:5432/elimuwrite
# Owner role: migrations and the retention job only.
OWNER_DATABASE_URL=postgres://elimu_owner:elimu_owner@localhost:5432/elimuwrite
STORAGE_DIR=./storage
SESSION_DAYS=14
COOKIE_SECURE=false            # true behind HTTPS
MAX_UPLOAD_MB=15
RUN_WORKER=true                # set false to run the analysis worker as a separate process
GUEST_DEMO_PER_MINUTE=5

# ---- Optional providers (leave blank: the UI shows "Not configured", nothing is faked)
ANTHROPIC_API_KEY=             # AI paraphrase modes, translation, tutor
LLM_MODEL=claude-sonnet-5-5
LLM_TIMEOUT_MS=30000
OCR_ENDPOINT=                  # scanned PDFs are held as "needs OCR" until set
MALWARE_SCAN_ENDPOINT=         # e.g. a ClamAV REST service
EXTERNAL_SIMILARITY_ENDPOINT=  # licensed web/publisher similarity service (commercial agreement)
EXTERNAL_SIMILARITY_KEY=
PAYMENT_PROVIDER=              # provider slug used in /api/webhooks/payments/:provider
PAYMENT_WEBHOOK_SECRET=        # HMAC-SHA256 secret for webhook signatures
CROSSREF_ENABLED=true          # DOI lookups need outbound access to api.crossref.org
CROSSREF_MAILTO=               # contact address for Crossref's polite pool (your ops mailbox)
